TOT_API_KEY=public_test_xxxxxxxxxxxxxxxx
TOT_SECRET_KEY=secret_test_xxxxxxxxxxxxxxxxxxxxxxxx
TOT_APP_DOMAIN=tokenoftrust.kiosk.com
TOT_API_BASE_URL=https://qa.tokenoftrust.com/api
TOT_RETURN_URL=https://tokenoftrust.kiosk.com/thanks
# Must be a publicly reachable URL for Token of Trust's completion webhook to
# reach this server (e.g. an ngrok/Cloudflare Tunnel URL in dev, your real
# domain in production). Leave unset to fall back to polling only.
PUBLIC_BASE_URL=

# 4-digit PIN required to unlock the staff view. Once entered correctly, the
# session stays unlocked in the browser for 4 hours before it's needed again.
STAFF_PIN=0118

PORT=3000

# DEV-ONLY: adds a "Dev: simulate verified" button to the kiosk UI that fakes
# a "cleared" verification, for testing the store/purchase gate without a
# real Token of Trust verification. Leave unset/false everywhere except your
# own local machine — NEVER set this to true on a real deployment.
DEV_ALLOW_MOCK_VERIFICATION=false
